{
  "name": "vault-lottery",
  "version": "1.0.1",
  "private": true,
  "description": "Randomizer games in the right sidebar: spin wheel, note lottery, dice & coin, team picker.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
